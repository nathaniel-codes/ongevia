# App
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PORT=3010

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ongevia
REDIS_URL=redis://localhost:6379

# Platform superadmin (email + password)
ADMIN_EMAIL=admin@ongevia.local
ADMIN_PASSWORD=change-me-strong-password

# Beem Africa SMS
BEEM_API_KEY=your-beem-api-key
BEEM_SECRET_KEY=your-beem-secret-key
BEEM_SOURCE_ADDR=NIATECH
BEEM_SMS_ENDPOINT=https://apisms.beem.africa/v1/send

# Swahilies Payments
SWAHILIES_API_KEY=your-swahilies-api-key
SWAHILIES_SECRET=your-swahilies-secret
SWAHILIES_USERNAME=niatech
SWAHILIES_ENDPOINT=https://swahiliesapi.invict.site/Api
SWAHILIES_IS_LIVE=true

# Wallet: credits granted per 1000 TZS top-up (admin can override)
CREDITS_PER_1000_TZS=100
DM_CREDIT_COST=1

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
PLATFORM_INSTAGRAM_USERNAME=ongevia
